# Supabase (Project Settings -> API in the Supabase dashboard, or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose this to the browser or commit a real value.
# Not used yet in Phase 0 — reserved for future server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build auth redirect links (magic link / signup confirmation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar OAuth (Phase 9). Create an OAuth 2.0 Client ID (Web
# application) in Google Cloud Console with the Calendar API enabled and
# this exact redirect URI added under "Authorized redirect URIs". While the
# OAuth consent screen is in "Testing" mode, only accounts added as test
# users can authorize — add your own Google account there first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Retention-tasks cron (Phase 12). Vercel sends this as
# `Authorization: Bearer <value>` on requests it triggers for the schedule
# in vercel.json — set to any random secret string. Not needed locally
# unless you're calling app/api/cron/retention-tasks by hand to test it.
CRON_SECRET=
