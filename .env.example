# Supabase (Project Settings -> API in the Supabase dashboard, or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose this to the browser or commit a real value.
# Not used yet in Phase 0 — reserved for future server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build auth redirect links (magic link / signup confirmation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar OAuth (added in Phase 9 — not used yet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
